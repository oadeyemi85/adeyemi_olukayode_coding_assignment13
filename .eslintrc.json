{
  "root": true,
  "extends": ["react-app", "react-app/jest", "prettier"],
  "ignorePatterns": ["build", "storybook-static", "node_modules", "coverage"],
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "error",
    "eqeqeq": ["error", "always"],
    "prefer-const": "error"
  }
}
