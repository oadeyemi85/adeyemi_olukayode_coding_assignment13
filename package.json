  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:ci": "react-scripts test --watchAll=false",
    "lint": "eslint src .storybook --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src .storybook --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test:ci",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/preset-create-react-app": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-webpack5": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "ajv": "^8.17.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest-styled-components": "^7.4.0",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "storybook": "^10.6.1",
    "webpack": "^5.111.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/*.tests.{ts,tsx}",
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ]
  }
}
